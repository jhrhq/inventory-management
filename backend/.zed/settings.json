{
  "tab_size": 2,
  "format_on_save": "on",

  "lsp": {
    "vtsls": {
      "initialization_options": {
        "javascript": {
          "preferences": {
            "format_on_save": "on",
            "importModuleSpecifierEnding": "js"
          }
        }
      }
    },
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },

  "languages": {
    "JavaScript": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    }
  }
}
